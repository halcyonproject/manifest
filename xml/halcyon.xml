<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="halcyon"
           fetch="https://github.com/hlcyn-callalily"
           revision="17.0" />

  <remote  name="hlcyn"
           fetch="https://github.com/halcyonproject"
           revision="17.0" />

